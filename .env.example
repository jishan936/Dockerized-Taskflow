# Copy this file to ".env" and change the values.
# PowerShell:  Copy-Item .env.example .env
# The real ".env" is ignored by Git. Never commit it.

# --- Flask ---
FLASK_APP=run.py
FLASK_DEBUG=0
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# --- PostgreSQL (used by the db container AND by Flask) ---
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=change-me-to-your-own-password
# Inside Docker Compose the host is the SERVICE NAME "db" (compose.yaml sets it for you).
# Only if you run Flask directly on Windows (outside Docker) would you use localhost.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Application ---
# Port you open in the browser: http://localhost:5000
APP_PORT=5000
# Name shown in the welcome heading
APP_USER_NAME=Student
